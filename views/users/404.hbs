<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 — PAGE NOT FOUND | BOOTCAMP ADMIN</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(90deg, #ffffff 50%, #f9f9fb 50%);
        }
        .font-display {
            font-family: 'Outfit', sans-serif;
        }
        .magnifying-glass-bg {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.01), inset 0 2px 4px rgba(0, 0, 0, 0.01);
        }
        @keyframes orbit-search {
            0% {
                transform: rotate(0deg) translate(6px) rotate(0deg);
            }
            100% {
                transform: rotate(360deg) translate(6px) rotate(-360deg);
            }
        }
        .animate-orbit {
            animation: orbit-search 4s linear infinite;
        }
        @keyframes pulse-ring {
            0% {
                transform: scale(0.98);
                box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.03);
            }
            70% {
                transform: scale(1.02);
                box-shadow: 0 0 0 12px rgba(0, 0, 0, 0);
            }
            100% {
                transform: scale(0.98);
                box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
            }
        }
        .pulse-effect {
            animation: pulse-ring 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
    </style>
</head>

<body class="min-h-screen w-full flex items-center justify-center p-6 select-none overflow-x-hidden antialiased">
    
    <div class="max-w-2xl w-full text-center flex flex-col items-center justify-center relative py-12">
        <!-- Circular Magnifying Glass Container -->
        <div class="w-32 h-32 rounded-full border border-gray-100 flex items-center justify-center bg-white/50 backdrop-blur-sm magnifying-glass-bg pulse-effect mb-10 transition-transform duration-500 hover:scale-105">
            <!-- Sleek SVG Magnifying Glass -->
            <svg class="w-14 h-14 text-zinc-300 stroke-current relative left-1 animate-orbit" fill="none" stroke="currentColor" stroke-width="1.25" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <circle cx="11" cy="11" r="6" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 16l5 5" />
            </svg>
        </div>

        <!-- 404 Headline -->
        <h1 class="font-display text-4xl md:text-5xl font-black text-black tracking-tight uppercase mb-6 leading-none selection:bg-black selection:text-white">
            404 — PAGE NOT FOUND
        </h1>

        <!-- Subtle horizontal line divider -->
        <div class="w-16 h-[2px] bg-zinc-800 mb-8 opacity-75"></div>

        <!-- Copy description -->
        <p class="text-[13px] md:text-[14px] text-gray-400 font-medium max-w-sm leading-relaxed mb-10 px-4 selection:bg-black selection:text-white">
            Sorry, we couldn't find the page you're looking for. It may have been moved, or perhaps you've mistyped the URL.
        </p>

        <!-- Go to Dashboard Action -->
        <a href="/users/home" class="px-8 py-4 bg-black text-white text-[10px] font-black uppercase tracking-[0.22em] rounded-sm hover:bg-zinc-800 transition-all duration-350 transform active:scale-95 shadow-lg shadow-black/5">
            GO TO HOME
        </a>
    </div>
</body>

</html>
